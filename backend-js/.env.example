DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rainfrog
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
# Keep this small for low-connection managed PostgreSQL plans. Defaults to 4.
PRISMA_CONNECTION_LIMIT=4
# Browser origins allowed to call the API. Comma-separate multiple deployed
# web origins; localhost and 127.0.0.1 are always allowed for local development.
WEB_APP_ORIGIN=http://192.168.1.10:8081
# Anonymous browser identities use sliding refresh sessions (default 180 days).
ANONYMOUS_SESSION_DAYS=180
